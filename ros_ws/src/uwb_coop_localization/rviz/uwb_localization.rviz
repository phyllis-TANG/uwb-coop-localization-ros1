Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Grid1
        - /Anchor Markers1
        - /Ground Truth Tag1
        - /UWB Estimate1
        - /Estimated Path1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.588679
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /uwb/anchors/markers
      Name: Anchor Markers
      Namespaces:
        uwb_anchor_labels: true
        uwb_anchors: true
      Queue Size: 100
      Value: true

    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /uwb/tag1/ground_truth_marker
      Name: Ground Truth Tag
      Namespaces:
        uwb_ground_truth: true
      Queue Size: 100
      Value: true

    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /uwb/tag1/estimate_marker
      Name: UWB Estimate
      Namespaces:
        uwb_estimate: true
      Queue Size: 100
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 170; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: Estimated Path
      Offset:
        X: 0
        Y: 0
        Z: 0.03
      Pose Color: 255; 85; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /uwb/tag1/path
      Unreliable: false
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: uwb_map
    Frame Rate: 30
  Name: root

  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point

  Value: true

  Views:
    Current:
      Class: rviz/Orbit
      Distance: 9
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 2.5
        Y: 2
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.35
      Target Frame: <Fixed Frame>
      Yaw: 0.65
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 000000ff
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1200
  X: 100
  Y: 100
